# Supabase (server-side only for the sync worker)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# EasyEcom authentication
EASYECOM_API_KEY=
EASYECOM_EMAIL=
EASYECOM_PASSWORD=
EASYECOM_LOCATION_KEY=
EASYECOM_JWT_TOKEN=

# EasyEcom order API
EASYECOM_CREATE_ORDER_URL=https://api.easyecom.io/webhook/v2/createOrder

# Batch processing
EASYECOM_BATCH_SIZE=10
EASYECOM_DRY_RUN=true
EASYECOM_MAX_RETRIES=2
EASYECOM_REQUEST_TIMEOUT_MS=30000
