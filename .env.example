# Supabase (server-side only for the sync worker)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# EasyEcom authentication
EASYECOM_API_KEY=
EASYECOM_EMAIL=
EASYECOM_PASSWORD=
EASYECOM_LOCATION_KEY=
EASYECOM_JWT_TOKEN=

# EasyEcom order API
EASYECOM_CREATE_ORDER_URL=https://api.easyecom.io/webhook/v2/createOrder

# Batch processing
EASYECOM_BATCH_SIZE=10
EASYECOM_DRY_RUN=true
EASYECOM_MAX_RETRIES=2
EASYECOM_REQUEST_TIMEOUT_MS=30000
EASYECOM_ORDER_DATE_FORMAT=offset
EASYECOM_INTERVAL_MS=2000

# EasyEcom auto-orders (checkout -> queue -> EasyEcom)
EASYECOM_ENABLED=false            # master switch; false = checkout never touches EasyEcom
EASYECOM_SEND_DISCOUNT=false      # true = send coupon discount as itemDiscount (past orders sent 0)
EASYECOM_AUTH_URL=https://api.easyecom.io/access/token
EASYECOM_ALERT_EMAIL=             # where failure alerts go
CRON_SECRET=                      # Bearer secret for /api/cron/* and /api/easyecom/retry

# ── Cash on Delivery ─────────────────────────────────────────────
# Master switch (read by the checkout and the server; needs a redeploy to change).
NEXT_PUBLIC_COD_ENABLED=false
# 32+ random chars; signs OTP hashes and email-verification tokens. REQUIRED IN PRODUCTION FOR ALL
# ORDERS: online and COD checkouts both require a verified email, so without it no order can be placed.
# (Checkout emails the code from no-reply@vhsmo.com; non-production logs it to the server console, and
# addresses ending in .test are never actually emailed.)
COD_OTP_SECRET=
# Legacy SMS OTP (Message Central VerifyNow). No longer used by checkout - email verification replaced it.
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_PASSWORD=
MESSAGECENTRAL_EMAIL=
