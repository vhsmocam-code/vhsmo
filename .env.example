# Supabase (server-side only for the sync worker)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# EasyEcom authentication
EASYECOM_API_KEY=
EASYECOM_EMAIL=
EASYECOM_PASSWORD=
EASYECOM_LOCATION_KEY=
EASYECOM_JWT_TOKEN=

# EasyEcom order API
EASYECOM_CREATE_ORDER_URL=https://api.easyecom.io/webhook/v2/createOrder

# Batch processing
EASYECOM_BATCH_SIZE=10
EASYECOM_DRY_RUN=true
EASYECOM_MAX_RETRIES=2
EASYECOM_REQUEST_TIMEOUT_MS=30000
EASYECOM_ORDER_DATE_FORMAT=offset
EASYECOM_INTERVAL_MS=2000

# EasyEcom auto-orders (checkout -> queue -> EasyEcom)
EASYECOM_ENABLED=false            # master switch; false = checkout never touches EasyEcom
EASYECOM_SEND_DISCOUNT=false      # true = send coupon discount as itemDiscount (past orders sent 0)
EASYECOM_AUTH_URL=https://api.easyecom.io/access/token
EASYECOM_ALERT_EMAIL=             # where failure alerts go
CRON_SECRET=                      # Bearer secret for /api/cron/* and /api/easyecom/retry
